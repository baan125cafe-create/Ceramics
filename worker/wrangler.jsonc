// Cloudflare settings for the shop API. Secrets (PINs, email key) are NOT here:
// set them with `npm run set-pin` / `npx wrangler secret put NAME`.
{
	"name": "shop-api",
	"main": "src/index.js",
	"compatibility_date": "2025-09-01",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB", // the code uses env.DB: keep this name
			"database_name": "shop-db",
			"database_id": "0337683b-dd92-48f9-8ed8-4624c2faaadd"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "shop-photos",
			"binding": "PHOTOS" // the code uses env.PHOTOS: keep this name
		}
	],
	"vars": {
		// Pages allowed to call the API from a browser (localhost is always allowed).
		"ALLOWED_ORIGINS": "https://milkyanyong.shop,https://www.milkyanyong.shop,https://baan125cafe-create.github.io",
		// Sender for email reports (milkyanyong.shop is verified in Resend).
		"REPORT_FROM": "Milk's shops <reports@milkyanyong.shop>"
	},
	// The API's address. Needs milkyanyong.shop to be active in this Cloudflare account;
	// Cloudflare creates the DNS record and certificate on deploy.
	"routes": [{ "pattern": "api.milkyanyong.shop", "custom_domain": true }],
	// Keep the backup address (shop-api.milkshops.workers.dev) working too.
	"workers_dev": true,
	// Email reports, Bangkok times: daily 23:30, monthly on the 1st at 10:30.
	"triggers": {
		"crons": [
			"30 16 * * *",
			"30 3 1 * *"
		]
	}
}