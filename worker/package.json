{
  "name": "shop-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:init:local": "wrangler d1 execute shop-db --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute shop-db --remote --file=schema.sql",
    "db:migrate:local": "wrangler d1 execute shop-db --local --file=migrations/0001_not_for_sale.sql",
    "db:migrate:remote": "wrangler d1 execute shop-db --remote --file=migrations/0001_not_for_sale.sql",
    "import": "node scripts/import-csv.mjs",
    "set-pin": "node scripts/set-pin.mjs",
    "test": "node test/api.test.mjs",
    "deploy": "wrangler deploy",
    "copy-photos": "node scripts/copy-photos.mjs"
  },
  "devDependencies": {
    "wrangler": "4.40.0"
  }
}
